# Copiar a .env y completar. Nunca subir .env al repositorio.

OFFICE_ENV=development
# SQLite local por defecto. En cloud: postgresql+psycopg://usuario:clave@host/db
OFFICE_DATABASE_URL=sqlite:///./data/office.db
# true: aplica migraciones al arrancar. false: ejecutar antes "kavryndex-office migrate".
OFFICE_AUTO_MIGRATE=true

# Clave de administrador para la API (cabecera X-API-Key). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
OFFICE_ADMIN_API_KEY=

# Política de coste: los proveedores de pago quedan bloqueados mientras sea false.
OFFICE_ALLOW_PAID_PROVIDERS=false

# Adaptador OpenAI-compatible opcional (Ollama local, Groq, Gemini...).
# Ollama:  http://localhost:11434/v1   Groq: https://api.groq.com/openai/v1
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
OFFICE_OPENAI_COMPAT_BASE_URL=
OFFICE_OPENAI_COMPAT_API_KEY=
# true = se trata como proveedor de pago (bloqueado por la política de coste).
# Poner false solo si el plan usado es gratuito y no tiene facturación activa.
OFFICE_OPENAI_COMPAT_IS_PAID=true

# Task Engine
OFFICE_RETRY_BASE_DELAY_S=5
OFFICE_RETRY_MAX_DELAY_S=300
OFFICE_STALE_RUN_AFTER_S=900
